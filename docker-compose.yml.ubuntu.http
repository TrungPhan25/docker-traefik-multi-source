services:
  # ============================================
  # TRAEFIK - Reverse Proxy
  # ============================================
  traefik:
    image: traefik:v2.11   # ← đổi về v2
    container_name: traefik
    profiles: ["infra"]
    environment:
      - DOCKER_API_VERSION=1.43
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.endpoint=unix:///var/run/docker.sock"
      - "--entrypoints.web.address=:80"
      - "--api.dashboard=true"
      - "--api.insecure=true"
    ports:
      - "80:80"
      - "8080:8080"
      # - "443:443"
      # volumes:
      #   - /var/run/docker.sock:/var/run/docker.sock:ro  
      # - ./docker/traefik/tls.yml:/traefik/tls.yml:ro
      # - ./docker/traefik/certs:/certs:ro
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - app-network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.traefik-dashboard.rule=Host(`traefik.trungphan.local`)"
      - "traefik.http.routers.traefik-dashboard.entrypoints=web"
      - "traefik.http.routers.traefik-dashboard.service=api@internal"
      # - "traefik.http.routers.traefik-dashboard.tls=true"

  # ============================================
  # MYSQL - Shared Database
  # ============================================
  mysql:
    image: mysql:8.0
    container_name: mysql
    profiles: ["infra", "project-a", "project-b", "src-laravel"]
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-rootsecret}
      MYSQL_USER: ${DB_USER:-laravel}
      MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
    volumes:
      - mysql_data:/var/lib/mysql
      - ./docker/mysql/init:/docker-entrypoint-initdb.d
    ports:
      - "3306:3306"
    networks:
      - app-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 3

  # ============================================
  # PHPMYADMIN
  # ============================================
  phpmyadmin:
    image: phpmyadmin:5
    ports:
      - "8090:80"
    container_name: phpmyadmin
    profiles: ["infra"]
    environment:
      PMA_HOST: mysql
      PMA_PORT: 3306
      PMA_USER: root
      PMA_PASSWORD: ${DB_ROOT_PASSWORD:-rootsecret}
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - app-network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pma.rule=Host(`pma.trungphan.local`)"
      - "traefik.http.routers.pma.entrypoints=web"
      - "traefik.http.routers.pma.service=pma-svc"      
      - "traefik.http.services.pma-svc.loadbalancer.server.port=80"
      # - "traefik.http.routers.pma.tls=true"
  # ============================================
  # src   redis
  # ============================================  
  redis:
    image: redis:alpine
    container_name: redis-e-invoice
    restart: unless-stopped
    networks:
      - app-network
  # ============================================
  # RabbitMQ
  # ============================================  
  rabbitmq:
    image: rabbitmq:3-management
    container_name: rabbitmq-e-invoice
    restart: unless-stopped
    ports:
      - "5672:5672"    # AMQP
      - "15672:15672"  # Management UI
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER:-admin}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD:-secret}
    networks:
      - app-network
  mailpit:
    image: axllent/mailpit
    container_name: mailpit
    restart: unless-stopped
    ports:
      - "1025:1025"  # SMTP
      - "8025:8025"  # Web UI
    networks:
      - app-network
  # ============================================
  # src   laravel - PHP 8.2
  # ============================================
  app-src-laravel:
    build:
      context: .
      dockerfile: docker/src-laravel/Dockerfile
    container_name: app-src-laravel
    profiles: ["src-laravel"]
    volumes:
    - ./httpdocs:/var/www/html
    - ./docker/src-laravel/xdebug.ini:/usr/local/etc/php/conf.d/xdebug.ini:ro
    working_dir: /var/www/html
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - app-network

  nginx-src-laravel:
    image: nginx:alpine
    container_name: nginx-src-laravel
    ports: 
      - "8081:80"
    profiles: ["src-laravel"]
    volumes:
      - ./httpdocs:/var/www/html
      - ./docker/src-laravel/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - app-src-laravel
    networks:
      - app-network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.src-laravel.rule=Host(`src-laravel.trungphan.local`)"
      - "traefik.http.routers.src-laravel.entrypoints=web"
      - "traefik.http.services.src-laravel-svc.loadbalancer.server.port=80"
      # - "traefik.http.routers.src-laravel.tls=true"
# ============================================
# NETWORKS & VOLUMES
# ============================================
networks:
  app-network:
    driver: bridge

volumes:
  mysql_data:
